<Window x:Class="SensorPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SensorPanel"
        Icon="Assets/SensorPanel.ico"
        Width="1440" Height="1030" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- Square icon-only toolbar button. The icon font is set on the icon only, so menus and tooltips keep the normal font. -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,8,16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sensor limitation note -->
        <Border x:Name="Banner" Grid.Row="0" Margin="0,0,0,10" Padding="12,8" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="BannerButton" DockPanel.Dock="Right" Margin="12,0,0,0" Click="BannerButton_Click" />
                <TextBlock x:Name="BannerText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="1">
            <TabItem Header="Editor">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="AddButton" Style="{StaticResource IconButton}" Click="Add_Click" ToolTip="Add item" AutomationProperties.Name="Add item">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Text" Tag="label" Click="AddItem_Click" />
                                    <MenuItem Header="Sensor value" Tag="value" Click="AddItem_Click" />
                                    <MenuItem Header="Sensor with bar" Tag="bar" Click="AddItem_Click" />
                                    <MenuItem Header="Gauge" Tag="gauge" Click="AddItem_Click" />
                                    <MenuItem Header="Graph" Tag="graph" Click="AddItem_Click" />
                                    <MenuItem Header="Image" Tag="image" Click="AddItem_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                        </Button>
                        <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
                            <TextBlock Text="&#xE7A6;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                        </Button>
                    </WrapPanel>

                    <Grid x:Name="EditorGrid" Grid.Row="1" SizeChanged="EditorGrid_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <!-- The preview takes the panel's size; the item list and properties share the rest. -->
                            <ColumnDefinition Width="2*" MinWidth="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="3*" MinWidth="360" />
                        </Grid.ColumnDefinitions>

                        <!-- Items -->
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Items" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Style="{StaticResource SecondaryText}"
                                           Text="Click an item in the preview to select it, drag to move it, arrow keys nudge it (Shift: 10 px)." />
                                <ListBox x:Name="ItemList" SelectionChanged="ItemList_SelectionChanged" PreviewMouseLeftButtonDown="ItemList_MouseDown"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Kind}" FontSize="11" VerticalAlignment="Center" Opacity="0.65" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Opacity="{Binding Opacity}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Opacity="0.65" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Preview -->
                        <!-- Sized to the panel, but never wider than the room left by the other two columns: a bigger
                             panel (e.g. a large HDMI screen) scrolls instead. -->
                        <Border x:Name="PreviewCard" Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,10,0"
                                PreviewMouseLeftButtonDown="PreviewArea_MouseDown">
                            <ScrollViewer x:Name="StageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                    <Grid.LayoutTransform>
                                        <ScaleTransform x:Name="StageScale" ScaleX="1.5" ScaleY="1.5" />
                                    </Grid.LayoutTransform>
                                    <Image x:Name="PreviewImage" Stretch="Fill" SnapsToDevicePixels="True" />
                                    <!-- Shown at the panel's size until the first frame (sensors take a moment to start). -->
                                    <Border x:Name="PreviewLoading" Background="Black">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <ProgressBar IsIndeterminate="True" Width="140" Margin="0,0,0,10" />
                                            <TextBlock Text="Loading sensors…" FontSize="10" Foreground="#B0B0B0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Canvas x:Name="Overlay" Background="Transparent" ClipToBounds="True" Focusable="True"
                                            MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseMove="Overlay_MouseMove"
                                            MouseLeftButtonUp="Overlay_MouseLeftButtonUp">
                                        <Rectangle x:Name="SelectionBox" Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                                   StrokeDashArray="3 2" StrokeThickness="0.6667" Visibility="Collapsed" IsHitTestVisible="False" />
                                    </Canvas>
                                </Grid>
                            </ScrollViewer>
                        </Border>

                        <!-- Properties -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,12,4,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Properties" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock x:Name="PropertiesTitle" DockPanel.Dock="Top" Margin="0,0,8,10" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource SecondaryText}" />
                                <!-- Actions for the selected item (hidden when the panel itself is shown). -->
                                <WrapPanel x:Name="ItemActions" DockPanel.Dock="Top" Margin="0,0,8,8">
                                    <Button x:Name="DuplicateButton" Content="Duplicate" Style="{StaticResource ToolButton}" Click="Duplicate_Click" ToolTip="Ctrl+D" />
                                    <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource ToolButton}" Click="Delete_Click" ToolTip="Delete key" />
                                    <Button x:Name="ForwardButton" Content="Bring forward" Style="{StaticResource ToolButton}" Click="Forward_Click"
                                            ToolTip="Draw this item over items it overlaps" />
                                    <Button x:Name="BackwardButton" Content="Send backward" Style="{StaticResource ToolButton}" Click="Backward_Click"
                                            ToolTip="Draw this item under items it overlaps" />
                                </WrapPanel>
                                <!-- Inset like the item list, so the settings are set apart from the heading and buttons. -->
                                <Border CornerRadius="4" Margin="0,0,8,0" Background="{Binding Background, ElementName=ItemList}"
                                        BorderBrush="{Binding BorderBrush, ElementName=ItemList}"
                                        BorderThickness="{Binding BorderThickness, ElementName=ItemList}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10,12,10">
                                        <StackPanel x:Name="PropertiesHost" />
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>

                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Display" FontWeight="SemiBold" Margin="2,0,0,8" />
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,6">
                            <StackPanel>
                                <DockPanel>
                                    <ComboBox x:Name="DisplayTypeBox" DockPanel.Dock="Right" Width="280" VerticalAlignment="Center"
                                              DisplayMemberPath="Name" SelectionChanged="DisplayTypeBox_SelectionChanged" />
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Display type" />
                                        <TextBlock x:Name="DisplayTypeDescription" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <!-- The chosen display type's own settings, if it has any. -->
                                <StackPanel x:Name="DisplaySettingsHost" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,18">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Open plugins folder" VerticalAlignment="Center" Click="OpenPlugins_Click" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Display plugins" />
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Add support for other displays by putting their plugin (a folder with its .dll) in SensorPanel's plugins folder, then restart SensorPanel. Plugins run with SensorPanel's administrator rights, so only add ones you trust." />
                                    <TextBlock x:Name="PluginList" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Panel file" FontWeight="SemiBold" Margin="2,0,0,8" />
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Import…" MinWidth="100" VerticalAlignment="Center" Click="Import_Click" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Import a panel" />
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Replace the current panel with one from a panel file (.sensorpanel, .axlcd or .ini). Undo in the editor brings the old one back." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,18">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Export…" MinWidth="100" VerticalAlignment="Center" Click="Export_Click" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Export this panel" />
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Save the panel and its pictures in one .sensorpanel file, as a backup or to use on another PC." />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="General" FontWeight="SemiBold" Margin="2,0,0,8" />
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,6">
                            <DockPanel>
                                <CheckBox x:Name="OutputBox" DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="0"
                                          Checked="OutputBox_Changed" Unchecked="OutputBox_Changed" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Show on display" />
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Send the panel to the USB display. Turning this off also switches the display's backlight off." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,6">
                            <DockPanel>
                                <CheckBox x:Name="StartupBox" DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="0"
                                          Checked="StartupBox_Changed" Unchecked="StartupBox_Changed" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Start with Windows" />
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Start SensorPanel in the background when you sign in, so the display works right away. No administrator prompt at startup." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,6">
                            <DockPanel>
                                <CheckBox x:Name="TrayBox" DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="0"
                                          Checked="TrayBox_Changed" Unchecked="TrayBox_Changed" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Show tray icon" />
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="When it's hidden, closing this window still keeps the display running in the background. To open the window again, start SensorPanel from the Start menu." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Exit" MinWidth="100" VerticalAlignment="Center" Click="Exit_Click" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Exit SensorPanel" />
                                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="Close SensorPanel completely. The display stops updating until it's started again." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status -->
        <DockPanel Grid.Row="2" Margin="2,8,2,0">
            <TextBlock x:Name="CursorText" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" />
            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
