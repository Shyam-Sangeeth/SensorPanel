<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- Builds SensorPanel-<version>-x64.msi. Use build-installer.ps1, which publishes the app and its plugins into
       payload\ first and passes the version through. -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)payload</PayloadDir>
    <OutputName>SensorPanel-$(Version)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>Version=$(Version);PayloadDir=$(PayloadDir);AssetsDir=$(MSBuildThisFileDirectory)..\SensorPanel\Assets</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standard installer dialogs (progress, finish, cancel, errors) used by the custom welcome screen. -->
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <!-- Runs schtasks without a console window flashing up. -->
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
