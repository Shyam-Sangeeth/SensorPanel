<Project Sdk="Microsoft.NET.Sdk">

  <!-- What display plugins build against. Reference this project (or SensorPanel.Plugins.dll), implement IDisplayDriver,
       and put the plugin (a folder with its DLL) in SensorPanel's plugins folder (App\plugins). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <!-- The contract's own version, kept when SensorPanel is built with a different -p:Version (the installer does
         this): plugins built against 1.0.0.0 can only load in a SensorPanel whose contract is at least that. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
